datasets/

# ─────────── Python ───────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# ─────────── 编辑器 / 系统 ───────────
.vscode/
.idea/
.DS_Store

