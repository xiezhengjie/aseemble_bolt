<mujoco model="ur5e scene">
  <include file="ur5e_assemble.xml" />
  <include file="catenary.xml" />

  <option integrator="implicitfast" iterations="30" timestep="0.001" gravity="0 0 -9.81" density="1.225" viscosity="1.8e-5" solver="Newton" noslip_iterations="3"/>

  <statistic center="0.3 0 0.4" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0" active="1"/>
    <rgba haze="0.15 0.25 0.35 1" />
    <!-- <quality shadowsize="16384" numslices="28" offsamples="4" /> -->  <!-- 仿真显示质量-->
    <global realtime="1" azimuth="120" elevation="-20" />
  </visual>

  <compiler angle="radian" meshdir="../assets/meshes" fitaabb="true" autolimits="true" />

  <asset>
    <!-- <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
    height="3072"/> -->
    <texture type="skybox" file="../assets/textures/desert.png" gridsize="3 4"
      gridlayout=".U..LFRB.D.." /> <!-- 天空盒 -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300" />    <!-- 地面纹理 -->
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2" />
  </asset>
  
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <!-- 遥操作观察相机：位于 catenary 侧上方，朝向 assembly_target -->
    <camera name="teleop_camera" mode="fixed" pos="0.568 0.30 0.32" xyaxes="1 0 0 0 0.640 -0.768" fovy="50"/>

    <body name="world_frame" pos="0 0 0">
      <geom name="X" type="cylinder" size="0.005" fromto="0 0 0 0.3 0 0" rgba="1 0 0 1" contype="0"
        conaffinity="0" />
      <geom name="Y" type="cylinder" size="0.005" fromto="0 0 0 0 0.3 0" rgba="0 1 0 1" contype="0"
        conaffinity="0" />
      <geom name="Z" type="cylinder" size="0.005" fromto="0 0 0 0 0 0.3" rgba="0 0 1 1" contype="0"
        conaffinity="0" />
    </body>

    <body name="catenary" pos="0.65 0 0.046" quat="0 0 0 -1">
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.01 0.01 0.01"/>
      <geom mesh="double_ear_sleeve_1_split_0" class="double_ear_sleeve_visual" />
      <geom class="catenary_collision" mesh="double_ear_sleeve_1_split_0" />

      <geom mesh="double_ear_sleeve_1_split_1" class="double_ear_sleeve_visual" />
      <geom class="catenary_collision" mesh="double_ear_sleeve_1_split_1" />

      <geom mesh="double_ear_sleeve_1_split_2" class="double_ear_sleeve_visual" />
      <geom class="catenary_collision" mesh="double_ear_sleeve_1_split_2" /> 

      <geom mesh="double_ear_sleeve_2_split_0" class="double_ear_sleeve_visual" />
      <geom class="catenary_collision" mesh="double_ear_sleeve_2_split_0" />

      <geom mesh="double_ear_sleeve_2_split_1" class="double_ear_sleeve_visual" />
      <geom class="catenary_collision" mesh="double_ear_sleeve_2_split_1" />

      <geom mesh="double_ear_sleeve_2_split_2" class="double_ear_sleeve_visual" />
      <geom class="catenary_collision" mesh="double_ear_sleeve_2_split_2" /> 

      <geom mesh="head_bolts_1" class="catenary_visual" />
      <geom class="catenary_collision" mesh="head_bolts_1" />

      <geom mesh="head_bolts_2" class="catenary_visual" />
      <geom class="catenary_collision" mesh="head_bolts_2" />

      <geom mesh="hex_bolts_1" class="catenary_visual" />
      <geom class="catenary_collision" mesh="hex_bolts_1" />

      <geom mesh="hex_bolts_2" class="catenary_visual" />
      <geom class="catenary_collision" mesh="hex_bolts_2" />

      <geom mesh="hex_bolts_3" class="catenary_visual" />
      <geom class="catenary_collision" mesh="hex_bolts_3" />

      <geom mesh="hex_nuts_1" class="catenary_visual" />
      <geom class="catenary_collision" mesh="hex_nuts_1" /> 

      <geom mesh="hex_nuts_2" class="catenary_visual" />
      <geom class="catenary_collision" mesh="hex_nuts_2" /> 

      <geom mesh="hex_nuts_3" class="catenary_visual" />
      <geom class="catenary_collision" mesh="hex_nuts_3" />

      <geom mesh="plain_washers_1" class="catenary_visual" />
      <geom class="catenary_collision" mesh="plain_washers_1" />

      <geom mesh="plain_washers_2" class="catenary_visual" />
      <geom class="catenary_collision" mesh="plain_washers_2" />


      <geom mesh="plain_washers_3" class="catenary_visual" />
      <geom class="catenary_collision" mesh="plain_washers_3" />

      <geom mesh="plain_washers_4" class="catenary_visual" />
      <geom class="catenary_collision" mesh="plain_washers_4" />

      <geom mesh="prevailing_torque_1" class="catenary_visual" />
      <geom class="catenary_collision" mesh="prevailing_torque_1" />

      <geom mesh="prevailing_torque_2" class="catenary_visual" />
      <geom class="catenary_collision" mesh="prevailing_torque_2" />

      <!-- 工作空间可视化框（catenary局部坐标，半透明不参与碰撞） -->
      <body name="workspace_box" pos="0.08247 0 0.07398">
        <geom type="box" size="0.04 0.04 0.06" rgba="0 0.7 1 0.12" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto="-0.04 -0.04 -0.06  0.04 -0.04 -0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto="-0.04  0.04 -0.06  0.04  0.04 -0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto="-0.04 -0.04  0.06  0.04 -0.04  0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto="-0.04  0.04  0.06  0.04  0.04  0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto="-0.04 -0.04 -0.06 -0.04  0.04 -0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto=" 0.04 -0.04 -0.06  0.04  0.04 -0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto="-0.04 -0.04  0.06 -0.04  0.04  0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto=" 0.04 -0.04  0.06  0.04  0.04  0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto="-0.04 -0.04 -0.06 -0.04 -0.04  0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto=" 0.04 -0.04 -0.06  0.04 -0.04  0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto="-0.04  0.04 -0.06 -0.04  0.04  0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
        <geom type="cylinder" size="0.0012" fromto=" 0.04  0.04 -0.06  0.04  0.04  0.06" rgba="0 0.7 1 0.5" contype="0" conaffinity="0" mass="0"/>
      </body>

      <!-- 装配目标点标记（红色球体，catenary局部X因quat旋转与世界X反向） -->
      <site name="assembly_target" pos="0.08247 0 0.02218" size="0.002" rgba="1 0 0 1" type="sphere" />
    </body>
  </worldbody>
</mujoco>